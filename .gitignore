/*

!.gitignore

!CLAUDE.md
!README.md

!docker_up.sh
!docker_down.sh
!docker-compose.yml

!data/
data/*
!data/mysql
data/mysql/*
!data/mysql/.gitkeep

!env/
env/*
!env/_sample.env

!nginx/
nginx/*
!nginx/etc/
nginx/etc/*
!nginx/etc/nginx.conf
!nginx/etc/templates
nginx/etc/templates/*
!nginx/etc/templates/default.conf.template

!wordpress/
wordpress/*
!wordpress/src
wordpress/src/*
!wordpress/src/.gitkeep